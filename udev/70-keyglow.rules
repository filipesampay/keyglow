# keyglow: dá ao usuário logado acesso ao teclado SONiX/EVision 320f:5016.
# - hidraw: controle das cores
# - input: leitura das teclas (só deste teclado, não de todos)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="320f", ATTRS{idProduct}=="5016", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{idVendor}=="320f", ATTRS{idProduct}=="5016", TAG+="uaccess"
